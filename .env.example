# ==========================================
# SpillATea — Environment & Database Configuration
# ==========================================

# Current Environment: 'development' or 'production'
NODE_ENV=development

# ==========================================
# 🔥 Firebase Configuration (Project: spillatea)
# ==========================================
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=spillatea.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=spillatea
VITE_FIREBASE_STORAGE_BUCKET=spillatea.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# ==========================================
# 🟢 MongoDB / Express Configuration
# ==========================================
MONGODB_DEV_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/spillatea_dev?retryWrites=true&w=majority
MONGODB_PROD_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/spillatea_prod?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/spillatea_dev?retryWrites=true&w=majority

# Express Backend Port
PORT=5000

# Frontend API URL
VITE_API_URL=http://localhost:5000/api
